+            z: 1000
 
             FilterBar {
                 id: wallpapersFilterBar
@@ -830,6 +844,22 @@ FocusScope {
                     wallpapersTabRoot.focusPreviousElement();
                 }
             }
+
+            // Layout mode at the extreme right of the filter row; same
+            // inline-expander pattern as the scheme selector above.
+            ModeSelector {
+                id: wallpaperModeSelector
+                anchors.right: parent.right
+                anchors.verticalCenter: parent.verticalCenter
+
+                onModeSelectorClosed: wallpapersTabRoot.focusSearch();
+
+                onEscapePressedOnMode: wallpapersTabRoot.focusSearch();
